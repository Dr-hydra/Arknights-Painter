<Window
    x:Class="ArknightsPainter.App.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="OverlayRoot"
        IsTabStop="True"
        Background="Black"
        KeyDown="OverlayRoot_KeyDown"
        PointerCanceled="OverlayRoot_PointerReleased"
        PointerCaptureLost="OverlayRoot_PointerReleased"
        PointerMoved="OverlayRoot_PointerMoved"
        PointerPressed="OverlayRoot_PointerPressed"
        PointerReleased="OverlayRoot_PointerReleased">
        <Image x:Name="ScreenImage" Stretch="Fill" />
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Rectangle x:Name="ShadeLeft" Fill="#80000000" IsHitTestVisible="False" />
            <Rectangle x:Name="ShadeTop" Fill="#80000000" IsHitTestVisible="False" />
            <Rectangle x:Name="ShadeRight" Fill="#80000000" IsHitTestVisible="False" />
            <Rectangle x:Name="ShadeBottom" Fill="#80000000" IsHitTestVisible="False" />
            <Rectangle
                x:Name="SelectionRect"
                Fill="#334FC3F7"
                IsHitTestVisible="False"
                Stroke="#4FC3F7"
                StrokeThickness="2"
                Visibility="Collapsed" />
            <Border
                x:Name="Toolbar"
                Padding="12,6"
                Background="#F2FFFFFF"
                BorderBrush="#40000000"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        x:Name="SizeText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#FF000000" />
                    <Button x:Name="ConfirmButton" Click="Confirm_Click" Content="确定" />
                    <Button x:Name="CancelButton" Click="Cancel_Click" Content="取消" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
