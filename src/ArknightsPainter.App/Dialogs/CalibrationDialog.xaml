<ContentDialog
    x:Class="ArknightsPainter.App.Dialogs.CalibrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="手动画面校准"
    PrimaryButtonText="保存校准"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="以下图片来自当前模拟器的实时截图，不是导入图片。拖动矩形调整位置，拖动右下角方块调整大小。"
            TextWrapping="Wrap" />
        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid x:Name="CalibrationSurface">
                <Image x:Name="ScreenshotImage" Stretch="Fill" />
                <Canvas x:Name="OverlayCanvas">
                    <Border
                        x:Name="CanvasRegion"
                        Background="#1800AEEF"
                        BorderBrush="#00AEEF"
                        BorderThickness="2"
                        PointerCanceled="Region_PointerReleased"
                        PointerCaptureLost="Region_PointerReleased"
                        PointerMoved="Region_PointerMoved"
                        PointerPressed="Region_PointerPressed"
                        PointerReleased="Region_PointerReleased">
                        <Grid>
                            <TextBlock
                                Margin="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="画布" />
                            <Border
                                x:Name="CanvasResizeHandle"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#00AEEF"
                                CornerRadius="2"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Region_PointerReleased" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="PaletteRegion"
                        Background="#18F5A623"
                        BorderBrush="#F5A623"
                        BorderThickness="2"
                        PointerCanceled="Region_PointerReleased"
                        PointerCaptureLost="Region_PointerReleased"
                        PointerMoved="Region_PointerMoved"
                        PointerPressed="Region_PointerPressed"
                        PointerReleased="Region_PointerReleased">
                        <Grid>
                            <TextBlock
                                Margin="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Foreground="White"
                                Text="颜料" />
                            <Border
                                x:Name="PaletteResizeHandle"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#F5A623"
                                CornerRadius="2"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Region_PointerReleased" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
