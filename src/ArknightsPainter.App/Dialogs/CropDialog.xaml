<ContentDialog
    x:Class="ArknightsPainter.App.Dialogs.CropDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="裁切图片"
    PrimaryButtonText="应用裁切"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="12">
        <Grid>
            <TextBlock
                x:Name="CropHint"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="拖动图片调整位置，滚轮缩放" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <TextBlock
                    x:Name="CropSummary"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Click="Reset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" />
                        <TextBlock Text="重置" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            HorizontalAlignment="Center"
            Background="#202020"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid
                x:Name="CropSurface"
                Width="620"
                Height="470"
                PointerCanceled="Interaction_PointerReleased"
                PointerCaptureLost="Interaction_PointerReleased"
                PointerMoved="Surface_PointerMoved"
                PointerPressed="Surface_PointerPressed"
                PointerReleased="Interaction_PointerReleased"
                PointerWheelChanged="Surface_PointerWheelChanged">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,620,470" />
                </Grid.Clip>
                <Canvas x:Name="ImageCanvas">
                    <Image x:Name="SourceImage" Stretch="Fill" />
                </Canvas>
                <Canvas x:Name="GuideCanvas" IsHitTestVisible="False">
                    <Border x:Name="ShadeLeft" Background="#99000000" />
                    <Border x:Name="ShadeTop" Background="#99000000" />
                    <Border x:Name="ShadeRight" Background="#99000000" />
                    <Border x:Name="ShadeBottom" Background="#99000000" />
                    <Canvas x:Name="GridCanvas" />
                    <Border
                        x:Name="CropFrame"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="2" />
                </Canvas>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
