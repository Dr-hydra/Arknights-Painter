<ContentDialog
    x:Class="ArknightsPainter.App.Dialogs.CropDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="裁切图片"
    PrimaryButtonText="应用裁切"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="12">
        <Grid>
            <TextBlock
                x:Name="CropSummary"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Click="CenterSquare_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A8;" />
                        <TextBlock Text="居中方形" />
                    </StackPanel>
                </Button>
                <Button Click="Reset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" />
                        <TextBlock Text="全图" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            HorizontalAlignment="Center"
            Background="#202020"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid x:Name="CropSurface">
                <Image x:Name="SourceImage" Stretch="Fill" />
                <Canvas x:Name="CropOverlay">
                    <Border x:Name="ShadeLeft" Background="#99000000" IsHitTestVisible="False" />
                    <Border x:Name="ShadeTop" Background="#99000000" IsHitTestVisible="False" />
                    <Border x:Name="ShadeRight" Background="#99000000" IsHitTestVisible="False" />
                    <Border x:Name="ShadeBottom" Background="#99000000" IsHitTestVisible="False" />

                    <Border
                        x:Name="CropRegion"
                        Background="#01000000"
                        BorderBrush="White"
                        BorderThickness="2"
                        PointerCanceled="Interaction_PointerReleased"
                        PointerCaptureLost="Interaction_PointerReleased"
                        PointerMoved="CropRegion_PointerMoved"
                        PointerPressed="CropRegion_PointerPressed"
                        PointerReleased="Interaction_PointerReleased">
                        <Grid>
                            <Border
                                x:Name="TopLeftHandle"
                                Width="16"
                                Height="16"
                                Margin="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#0078D4"
                                CornerRadius="2"
                                Tag="Left,Top"
                                PointerCanceled="Interaction_PointerReleased"
                                PointerCaptureLost="Interaction_PointerReleased"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Interaction_PointerReleased" />
                            <Border
                                x:Name="TopRightHandle"
                                Width="16"
                                Height="16"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#0078D4"
                                CornerRadius="2"
                                Tag="Right,Top"
                                PointerCanceled="Interaction_PointerReleased"
                                PointerCaptureLost="Interaction_PointerReleased"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Interaction_PointerReleased" />
                            <Border
                                x:Name="BottomLeftHandle"
                                Width="16"
                                Height="16"
                                Margin="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="#0078D4"
                                CornerRadius="2"
                                Tag="Left,Bottom"
                                PointerCanceled="Interaction_PointerReleased"
                                PointerCaptureLost="Interaction_PointerReleased"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Interaction_PointerReleased" />
                            <Border
                                x:Name="BottomRightHandle"
                                Width="16"
                                Height="16"
                                Margin="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#0078D4"
                                CornerRadius="2"
                                Tag="Right,Bottom"
                                PointerCanceled="Interaction_PointerReleased"
                                PointerCaptureLost="Interaction_PointerReleased"
                                PointerMoved="ResizeHandle_PointerMoved"
                                PointerPressed="ResizeHandle_PointerPressed"
                                PointerReleased="Interaction_PointerReleased" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
